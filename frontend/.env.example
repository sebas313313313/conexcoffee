# ============================================
# ConexCoffee — Variables de Entorno (Frontend)
# ============================================
# ⚠️ SOLO variables públicas con prefijo VITE_
# ⚠️ NUNCA incluir: SECRET_KEY, DATABASE_URL, JWT_SECRET, PAYMENT_SECRET_KEY
# ============================================

# URL base de la API del backend (Localhost)
VITE_API_BASE_URL=http://localhost:5000/api
API_PROXY_TARGET=http://localhost:5000

# Llave pública de la pasarela de pagos
VITE_PAYMENT_PUBLIC_KEY=pk_test_xxxx

# Cloudflare Turnstile Captcha (Site Key pública)
# Para producción: crear en https://dash.cloudflare.com/
# Si se deja vacío en local, usará modo interactivo de desarrollo.
VITE_TURNSTILE_SITE_KEY=

# Nombre de la aplicación
VITE_APP_NAME=ConexCoffee

# Modo demo (sin backend): login/registro simulados. Activo por defecto en dev.
# En produccion poner false cuando exista el backend; true para desplegar una demo.
VITE_ENABLE_DEMO=true

# Ping periodico al backend (opt-in; preferir un cron externo)
VITE_ENABLE_KEEPALIVE=false
